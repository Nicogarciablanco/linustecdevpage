# Copiar a .env.local SOLO para desarrollo. Cargar secretos en el hosting, nunca en VITE_*.
# La única variable pública se incluye en el build:
VITE_TURNSTILE_SITE_KEY=

# Configuración privada del servidor. Valores vacíos deshabilitan el envío (503).
SITE_ORIGIN=
MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM=
MAIL_TO=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SECRET=
